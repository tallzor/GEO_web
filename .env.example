# 火山方舟服务端配置。复制为 .env.local 后填写，禁止使用 NEXT_PUBLIC_ 前缀。
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_DEEPSEEK_MODEL=deepseek-v4-flash-260425

# 腾讯混元服务端配置。HUNYUAN_API_KEY仅保存在服务端环境变量中。
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy3

# 独立底座模型配置。Key与采集层分开，禁止使用 NEXT_PUBLIC_ 前缀。
# 后续更换平台时只需新增适配器并修改 GEO_FOUNDATION_PROVIDER。
GEO_FOUNDATION_PROVIDER=ark
GEO_FOUNDATION_API_KEY=
GEO_FOUNDATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
GEO_FOUNDATION_MODEL=deepseek-v4-flash-ga-260731
GEO_FOUNDATION_TIMEOUT_MS=240000

# 生产环境启用服务端检测接口；本地开发默认启用。
ENABLE_LOCAL_AI_API=true

# 可选：检测任务JSON数据目录。单机部署可留空，默认写入项目 data 目录。
GEO_DATA_DIR=

# Supabase 正式数据服务。浏览器只使用 Publishable Key，Secret Key 仅限服务端。
# 浏览器仅允许使用 Publishable Key；Secret Key 只能配置在服务端环境。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# local：使用 localStorage/JSON 演示数据；supabase：使用 PostgreSQL、RLS 和私有 Storage。
GEO_DATA_BACKEND=local

# demo：保留当前演示登录；supabase：启用内测账号真实登录和服务端路由保护。
# GEO_DATA_BACKEND=supabase 时，GEO_AUTH_MODE 必须同时为 supabase。
GEO_AUTH_MODE=demo

# 多平台草稿同步。凭据密钥可用 `openssl rand -base64 32` 生成；两项都只放服务端。
PUBLISHING_CREDENTIALS_KEY=
PUBLISH_WORKER_TOKEN=
# 检测 Worker 专用令牌；暂不填写时可复用 PUBLISH_WORKER_TOKEN。
GEO_WORKER_TOKEN=
# 单次最多并行采集的平台数；同一平台始终串行，建议保持默认值 3。
GEO_COLLECTION_CONCURRENCY=3

# 发布任务轮询器从服务器本机调用该地址；公网链接用于移动端提示和浏览器扩展配置。
GEO_INTERNAL_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SERVER_EGRESS_IP=
