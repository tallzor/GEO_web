{
  "manifest_version": 3,
  "name": "GEO 知乎草稿同步助手",
  "version": "0.1.0",
  "description": "领取GEO网站中的知乎同步任务，填入知乎编辑器并保存为草稿。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "GEO 知乎草稿同步助手" },
  "content_scripts": [{
    "matches": ["https://zhuanlan.zhihu.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
